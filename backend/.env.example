DATABASE_URL="mysql://trip_ticket:change-me@127.0.0.1:3306/emb_trip_ticket"
PORT=5001
FRONTEND_URL=http://localhost:3006
# Set this to the computer's LAN URL when the kiosk is opened from another device.
FRONTEND_LAN_URL=http://192.168.1.123:3006
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=1d
# Puppeteer silently renders receipts, then sends them to this Windows printer.
EMB_RECEIPT_PRINTER=EPSON TM-T82 Receipt
# Optional override; Chrome / Edge / Chromium is detected when omitted.
EMB_PRINT_BROWSER_PATH=
# For an Ethernet thermal printer (including Docker), set its reachable IP.
EMB_RECEIPT_HOST=
EMB_RECEIPT_PORT=9100
EMB_RECEIPT_WIDTH_DOTS=576
EMB_GPS_DEVICE_KEY=
# Devices are assigned to vehicles in the tracking_devices table.
OSRM_URL=http://127.0.0.1:5000
# ESP32 firmware posts scanned cards to:
# http://<BACKEND-HOST-LAN-IP>:5001/api/rfid/read
EMB_ESP32_TIMEOUT_MS=65000
# Firmware should POST /api/rfid/health every 5 seconds while the reader is healthy.
EMB_ESP32_HEARTBEAT_TIMEOUT_MS=15000
EMB_ESP32_API_KEY=
